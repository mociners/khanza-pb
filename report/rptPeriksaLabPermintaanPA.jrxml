	<queryString>
		<![CDATA[SELECT temporary_lab.temp3, temporary_lab.temp4, temporary_lab.temp5, temporary_lab.temp6,
		(
			SELECT IFNULL(spesialis.nm_sps, '-')
			FROM periksa_lab
			INNER JOIN dokter ON periksa_lab.dokter_perujuk = dokter.kd_dokter
			INNER JOIN spesialis ON dokter.kd_sps = spesialis.kd_sps
			WHERE periksa_lab.no_rawat = $P{noperiksa}
			LIMIT 1
		) as spesialis_perujuk
		FROM temporary_lab]]>
	</queryString>
