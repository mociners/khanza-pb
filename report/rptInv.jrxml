	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="ruang" class="java.lang.String"/>
	<parameter name="parameter" class="java.lang.String"/>
	<queryString>
		<![CDATA[select inventaris_barang.kode_barang, inventaris_barang.nama_barang, inventaris_merk.nama_merk, inventaris_barang.thn_produksi, inventaris_barang.isbn, inventaris_kategori.nama_kategori, inventaris_jenis.nama_jenis, inventaris.asal_barang, inventaris.tgl_pengadaan, inventaris.harga, inventaris.status_barang, inventaris_ruang.nama_ruang, count(inventaris.no_inventaris) as jumlah 
        from inventaris 
        inner join inventaris_barang on inventaris_barang.kode_barang=inventaris.kode_barang 
        inner join inventaris_ruang on inventaris.id_ruang=inventaris_ruang.id_ruang 
        inner join inventaris_jenis on inventaris_barang.id_jenis=inventaris_jenis.id_jenis 
        inner join inventaris_kategori on inventaris_barang.id_kategori=inventaris_kategori.id_kategori 
        inner join inventaris_merk on inventaris_barang.id_merk=inventaris_merk.id_merk 
        where inventaris_ruang.nama_ruang like $P{ruang} 
        and (inventaris_barang.kode_barang like $P{parameter} 
        or inventaris_barang.nama_barang like $P{parameter} 
        or inventaris.asal_barang like $P{parameter} 
        or inventaris.tgl_pengadaan like $P{parameter} 
        or inventaris.status_barang like $P{parameter} 
        or inventaris_ruang.nama_ruang like $P{parameter} 
        or inventaris_merk.nama_merk like $P{parameter} 
        or inventaris_barang.thn_produksi like $P{parameter} 
        or inventaris_barang.isbn like $P{parameter} 
        or inventaris_kategori.nama_kategori like $P{parameter} 
        or inventaris_jenis.nama_jenis like $P{parameter})
        GROUP BY inventaris_barang.kode_barang, inventaris_barang.nama_barang, inventaris_merk.nama_merk, inventaris_barang.thn_produksi, inventaris_barang.isbn, inventaris_kategori.nama_kategori, inventaris_jenis.nama_jenis, inventaris.asal_barang, inventaris.tgl_pengadaan, inventaris.harga, inventaris.status_barang, inventaris_ruang.nama_ruang
        ORDER BY inventaris_barang.kode_barang]]>
	</queryString>
