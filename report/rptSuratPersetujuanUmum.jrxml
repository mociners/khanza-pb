				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[Selaku pasien / orang tua pasien / suami pasien / istri pasien / keluarga pasien (coret yang tidak perlu) dari pasien tersebut diatas, dengan ini MENYATAKAN Persetujuan:]]></text>
			</staticText>
		</band>
		<band height="170">
			<staticText>
				<reportElement x="0" y="0" width="592" height="12" uuid="a1b2c3d4-e5f6-7890-1234-567890123456"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[1. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="12" y="12" width="15" height="12" uuid="b1c2d3e4-f5a6-7890-1234-567890123456"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[a.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="12" width="565" height="12" uuid="c1d2e3f4-a5b6-7890-1234-567890123456"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya mengetahui bahwa saya memiliki kondisi yang membutuhkan perawatan medis, saya mengijinkan dokter dan profesional kesehatan lainnya untuk melakukan prosedur diagnostik, elektrokardiogram dan untuk memberikan pengobatan medis seperti yang diperlukan dalam penilaian profesional mereka, prosedur diagnostik dan perawatan medis termasuk terapi tidak terbatas pada elektrokardiogram, x-ray, tes darah, terapi fisik dan pemberian obat."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="12" y="24" width="15" height="12" uuid="d1e2f3a4-b5c6-7890-1234-567890123456"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[b.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="24" width="565" height="12" uuid="e1f2a3b4-c5d6-7890-1234-567890123456"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya sadar bahwa praktik kedokteran dan bedah bukanlah ilmu pasti dan saya mengakui tidak ada jaminan atas hasil apapun terhadap perawatan prosedur atau pemeriksaan apapun yang dilakukan kepada saya."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="12" y="36" width="15" height="12" uuid="f1a2b3c4-d5e6-7890-1234-567890123456"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[c.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="36" width="565" height="12" uuid="12345678-90ab-cdef-1234-567890abcdef"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya mengerti dan memahami bahwa :\n"+
"-  Saya memiliki hak untuk mengajukan pertanyaan tentang pengobatan yang diusulkan (termasuk identitas setiap orang yang memberikan atau mengamati pengobatan) setiap saat.\n"+
"-  Saya mengerti dan memahami bahwa saya memiliki hak untuk persetujuan atau menolak persetujuan untuk setiap prosedur/tindakan.\n"+
"-  Saya mengerti bahwa banyak dokter pada staf medis rumah sakit yang bukan karyawan tetap staf tamu yang telah diberikan hak untuk menggunakan fasilitas untuk perawatan dan pengobatan pasien mereka."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="12" y="48" width="15" height="12" uuid="23456789-0abc-def1-2345-67890abcdef1"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[d.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="48" width="565" height="12" uuid="34567890-abcd-ef12-3456-7890abcdef12"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Melalui dokumen ini, saya menegaskan kembali bahwa saya mempercayakan kepada semua tenaga kesehatan rumah sakit untuk memberikan perawatan, diagnostik, dan terapi kepada saya sebagai pasien rawat inap atau rawat jalan atau instalasi gawat darurat (IGD), termasuk semua pemeriksaan penunjang, yang dibutuhkan untuk pengobatan dan tindakan yang aman."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="65" width="592" height="12" uuid="45678901-bcde-f123-4567-890abcdef123"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[2. PERSETUJUAN PELEPASAN INFORMASI]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="12" y="77" width="15" height="12" uuid="56789012-cdef-1234-5678-90abcdef1234"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[a.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="77" width="565" height="12" uuid="67890123-def0-1234-5678-90abcdef1234"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya memahami informasi yang ada dalam diri saya termasuk diagnosa, hasil laboratorium dan hasil tes diagnostik yang akan digunakan untuk perawatan medis "+$P{namars}+" akan menjamin kerahasiaannya."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="12" y="89" width="15" height="12" uuid="78901234-ef01-2345-6789-0abcdef12345"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[b.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="89" width="565" height="12" uuid="89012345-f012-3456-7890-abcdef123456"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya memberi wewenang kepada "+$P{namars}+" untuk memberikan informasi tentang diagnosa, hasil pelayanan dan pengobatan bila diperlukan untuk memproses klaim asuransi/ Jamkesmas/Jamkesda/Perusahaan atau lembaga pemerintah."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="12" y="101" width="15" height="12" uuid="90123456-0123-4567-8901-bcdef1234567"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[c.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="101" width="565" height="12" uuid="01234567-1234-5678-9012-cdef12345678"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya memberi wewenang kepada "+$P{namars}+" untuk memberikan informasi tentang diagnosa, hasil pelayanan dan pengobatan saya kepada anggota keluarga saya, kepada:\n"+
"1. .............................................................\n"+
"2. ............................................................."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="12" y="113" width="15" height="12" uuid="12345678-2345-6789-0123-def123456789"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[d.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="113" width="565" height="12" uuid="23456789-3456-7890-1234-ef1234567890"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya mengetahui dan menyetujui bahwa berdasarkan Peraturan Menteri Kesehatan No. 24 Tahun 2022 tentang Rekam Medis, fasilitas pelayanan kesehatan wajib membuka akses dan mengirim data rekam medis kepada Kementrian Kesehatan melalui Platform SATUSEHAT."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="12" y="125" width="15" height="12" uuid="34567890-4567-8901-2345-f01234567890"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[e.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="125" width="565" height="12" uuid="45678901-5678-9012-3456-012345678901"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Menyetujui untuk menerima dan membuka data pasien dari Fasilitas Pelayanan Kesehatan lainnya melalui SATUSEHAT untuk kepentingan pelayanan kesehatan dan/atau rujukan."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="142" width="592" height="12" uuid="56789012-6789-0123-4567-123456789012"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[3. PRIVASI]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="154" width="580" height="12" uuid="67890123-7890-1234-5678-234567890123"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya mengijinkan/tidak mengijinkan (coret salah satu) kepada "+$P{namars}+" memberi akses bagi keluarga dan handai taulan serta orang-orang yang akan menengok/menemui saya ......................................................................................................................................................................................................\n"+
"Saya menginginkan / tidak menginginkan (coret salah satu) privasi khusus."]]></textFieldExpression>
			</textField>
		</band>
		<band height="250">
			<staticText>
				<reportElement positionType="Float" x="0" y="0" width="592" height="12" uuid="78901234-8901-2345-6789-345678901234"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[4. BARANG-BARANG MILIK PASIEN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="12" width="580" height="12" uuid="89012345-9012-3456-7890-456789012345"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya telah memahami tata tertib "+$P{namars}+" bahwa saya dilarang membawa barang berharga, alat elektronik, karena jika terjadi kehilangan rumah sakit tidak bertanggung jawab kecuali jika saya menitipkan barang berharga saya ke rumah sakit dengan mengisi formulir penitipan dan pengambilan harta benda."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="29" width="592" height="12" uuid="90123456-0123-4567-8901-567890123456"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[5. HAK DAN KEWAJIBAN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="41" width="580" height="12" uuid="01234567-1234-5678-9012-678901234567"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Dengan menandatangani dokumen ini saya mengakui bahwa pada proses pendaftaran untuk mendapatkan perawatan di "+$P{namars}+" telah mendapatkan informasi tentang hak-hak dan kewajiban saya sebagai pasien sebagaimana tercantum pada Undang-Undang No. 44 Tahun 2009 tentang Hak Pasien dan Kewajiban Pasien (Terlampir)."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="58" width="592" height="12" uuid="12345678-2345-6789-0123-789012345678"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[6. RAHASIA MEDIS]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="70" width="580" height="12" uuid="23456789-3456-7890-1234-890123456789"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya setuju "+$P{namars}+" wajib menjamin kerahasiaan informasi medis saya baik untuk kepentingan perawatan dan pengobatan, pendidikan maupun penelitian kecuali saya mengungkapkan sendiri orang yang lain yang saya beri kuasa untuk itu."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="87" width="592" height="12" uuid="34567890-4567-8901-2345-901234567890"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[7. PENGAJUAN KELUHAN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="99" width="580" height="12" uuid="45678901-5678-9012-3456-012345678901"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya menyatakan bahwa saya telah menerima informasi tentang adanya tatacara mengajukan dan mengatasi keluhan terkait pelayanan medik yang diberikan terhadap diri saya. Saya setuju untuk mengikuti tata cara mengajukan keluhan sesuai prosedur yang ada."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="116" width="592" height="12" uuid="56789012-6789-0123-4567-123456789012"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[8. PELAYANAN KEROHANIAN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="128" width="580" height="12" uuid="67890123-7890-1234-5678-234567890123"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya memahami informasi bahwa selama perawatan di ruang rawat inap akan diberikan satu kali pelayanan kerohanian sesuai dengan agama "+$F{agama}+" yang saya anut kecuali bila saya non muslim, saya akan mengajukan permintaan pelayanan kerohanian kepada "+$P{namars}+"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="145" width="592" height="12" uuid="78901234-8901-2345-6789-345678901234"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[9. IDENTIFIKASI NILAI-NILAI DAN KEPERCAYAAN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="157" width="580" height="12" uuid="89012345-9012-3456-7890-456789012345"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya / Pasien memohon kepada "+$P{namars}+" agar tidak memberikan terapi atau melakukan tindakan yang bertentangan dengan nilai-nilai akan kepercayaan saya / pasien."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="174" width="592" height="12" uuid="90123456-0123-4567-8901-567890123456"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[10. INFORMASI RAWAT JALAN / RAWAT INAP]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="12" y="186" width="15" height="12" uuid="01234567-1234-5678-9012-678901234567"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[a.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="186" width="565" height="12" uuid="12345678-2345-6789-0123-789012345678"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya/pasien tidak diperkenankan untuk membawa barang berharga keruang rawat jalan/inap dan saya memahami bahwa "+$P{namars}+" tidak bertanggungjawab apabila terjadi kehilangan barang milik pasien/pengunjung."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="12" y="198" width="15" height="12" uuid="23456789-3456-7890-1234-890123456789"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[b.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="198" width="565" height="12" uuid="34567890-4567-8901-2345-901234567890"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Bila tidak ada anggota keluarga, rumah sakit menyediakan tempat penitipan barang milik pasien ditempat resmi yang telah disediakan oleh "+$P{namars}+"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="12" y="210" width="15" height="12" uuid="45678901-5678-9012-3456-012345678901"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[c.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="210" width="565" height="12" uuid="56789012-6789-0123-4567-123456789012"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya telah menerima informasi tentang peraturan yang diberlakukan oleh "+$P{namars}+" dan saya beserta keluarga bersedia mematuhinya, termasuk akan mematuhi jam berkunjung pasien sesuai dengan aturan "+$P{namars}+"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="12" y="222" width="15" height="12" uuid="67890123-7890-1234-5678-234567890123"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[d.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="222" width="565" height="12" uuid="78901234-8901-2345-6789-345678901234"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Anggota keluarga yang menunggu saya, bersedia untuk selalu memakai tanda pengenal khusus yang diberikan "+$P{namars}+", demi keamanan seluruh pasien setiap keluarga dan siapapun yang mengunjungi saya diluar jam berkunjung, bersedia untuk diminta/diperiksa identitasnya dan memakai identitas yang diberikan oleh "+$P{namars}+"."]]></textFieldExpression>
			</textField>
		</band>
		<band height="400">
			<staticText>
				<reportElement positionType="Float" x="0" y="0" width="592" height="12" uuid="89012345-9012-3456-7890-456789012345"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[11. INFORMASI BIAYA]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="12" width="580" height="12" uuid="90123456-0123-4567-8901-567890123456"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya memahami dan menyetujui tentang informasi biaya pengobatan ataupun tindakan yang telah dijelaskan oleh petugas sesuai dengan peraturan "+$P{namars}+" :"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="27" y="24" width="565" height="12" uuid="01234567-1234-5678-9012-678901234567"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Pasien Rawat Jalan]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="37" y="36" width="555" height="12" uuid="12345678-2345-6789-0123-789012345678"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["\u2610 Saat mendaftar di Instalasi Rawat Jalan, wajib melengkapi persyaratan jaminan pembayaran "+$P{namars}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="27" y="48" width="565" height="12" uuid="23456789-3456-7890-1234-890123456789"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Pasien Rawat Inap]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="37" y="60" width="555" height="12" uuid="34567890-4567-8901-2345-901234567890"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["\u2610 Bersedia melengkapi persyaratan jaminan pembayaran dalam waktu 1 x 24 jam terhitung sejak hari, tanggal dan jam masuk di "+$P{namars}+".\n"+
"Apabila dalam tempo waktu yang telah ditetapkan, tidak dapat menyatakan jaminan BPJS maka bersedia menjadi pasien umum"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="27" y="72" width="565" height="12" uuid="45678901-5678-9012-3456-012345678901"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Pasien Instalasi Gawat Darurat]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="37" y="84" width="555" height="12" uuid="56789012-6789-0123-4567-123456789012"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["\u2610 Bagi pasien BPJS yang masuk melalui IGD, apabila hasil skrining awal tidak memenuhi kriteria Gawat Darurat, bersedia untuk membayar biaya perawatan dan terdaftar sebagai pasien umum."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="101" width="592" height="12" uuid="67890123-7890-1234-5678-234567890123"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[12. KEWAJIBAN PEMBAYARAN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="113" width="580" height="12" uuid="78901234-8901-2345-6789-345678901234"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya menyatakan setuju, baik sebagai wali atau sebagai pasien, bahwa sesuai pertimbangan pelayanan yang diberikan kepada pasien, maka saya wajib untuk membayar total biaya pelayanan. Biaya pelayanan berdasarkan acuan biaya dan ketentuan "+$P{namars}+". Apabila asuransi kesehatan swasta atau program pemerintah menanggung pembiayaan saya, saya memberi wewenang kepada rumah sakit untuk memberi tagihan dari semua pelayanan dan tindakan medis yang diberikan, Tanggungan asuransi saya mungkin menyatakan bahwa sebagian pembayaran tetap menjadi tanggung jawab pribadi saya atau tidak ditanggung oleh asuransi, maka rumah sakit berwenang memberi tagihan untuk biaya yang tidak ditanggung oleh asuransi dan saya bertanggung jawab untuk membayarnya."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="12" y="125" width="15" height="12" uuid="89012345-9012-3456-7890-456789012345"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[a.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="125" width="565" height="12" uuid="90123456-0123-4567-8901-567890123456"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Apabila saya tidak memberikan persetujuan, atau dikemudian hari mencabut persetujuan saya untuk melepas rahasia kedokteran saya kepada perusahaan asuransi yang saya tentukan, maka saya pribadi bertanggung jawab untuk membayar semua pelayanan dan tindakan medis dari "+$P{namars}+"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="12" y="137" width="15" height="12" uuid="01234567-1234-5678-9012-678901234567"/>
				<textElement>
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[b.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="137" width="565" height="12" uuid="12345678-2345-6789-0123-789012345678"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Apabila rumah sakit membutuhkan proses hukum untuk menagih biaya pelayan rumah sakit dari saya, saya memahami bahwa saya bertanggung jawab untuk membayar semua biaya yang disebabkan dari proses hukum tersebut."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="155" width="580" height="12" uuid="23456789-3456-7890-1234-890123456789"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Dengan ini menyatakan BERSEDIA membayar seluruh biaya pelayanan atau selisih di luar pertanggung jawaban jaminan kesehatan sesuai dengan ketentuan "+$P{namars}+" yang terjadi atas diri pasien dengan cara pembayaran sebagai berikut :"]]></textFieldExpression>
			</textField>
			<frame>
				<reportElement positionType="Float" x="12" y="172" width="570" height="90" uuid="34567890-4567-8901-2345-901234567890"/>
				<rectangle>
					<reportElement x="0" y="2" width="10" height="10" uuid="45678901-5678-9012-3456-012345678901"/>
					<graphicElement>
						<pen lineWidth="0.5"/>
					</graphicElement>
				</rectangle>
				<staticText>
					<reportElement x="15" y="2" width="100" height="11" uuid="56789012-6789-0123-4567-123456789012"/>
					<textElement>
						<font fontName="Tahoma" size="8" isBold="true"/>
					</textElement>
					<text><![CDATA[UMUM]]></text>
				</staticText>
				<staticText>
					<reportElement x="15" y="14" width="550" height="11" uuid="67890123-7890-1234-5678-234567890123"/>
					<textElement>
						<font fontName="Tahoma" size="8"/>
					</textElement>
					<text><![CDATA[Saya telah mendapatkan penjelasan manfaat / jaminan kesehatan dan MENOLAK untuk menggunakan jaminan kesehatan.]]></text>
