					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Jasa Raharja, alasan " + ($F{alasan_tolak_jasa_raharja}==null ? "" : $F{alasan_tolak_jasa_raharja})]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="234" width="560" height="12" uuid="18340084-a653-45b4-b42f-debea4b10eaa"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{jenis_pembiayaan}!=null && $F{jenis_pembiayaan}.toUpperCase().contains("ASURANSI") ? "[ v ]" : "[   ]") + " ASURANSI SWASTA"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="247" width="545" height="12" uuid="6982da28-dfe6-472b-8bc4-0434b44fed45"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Nama Perusahaan Asuransi " + ($F{asuransi_swasta}==null ? "" : $F{asuransi_swasta})]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="260" width="545" height="12" uuid="2a13d806-e3e2-49e9-9706-40352b850e1c"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["No. Kartu Peserta " + ($F{no_kartu_asuransi}==null ? "" : $F{no_kartu_asuransi})]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="273" width="560" height="12" uuid="3714fbce-ab3c-431d-b0ef-612409a079d0"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{jenis_pembiayaan}!=null && $F{jenis_pembiayaan}.toUpperCase().contains("JASA RAHARJA") ? "[ v ]" : "[   ]") + " JASA RAHARJA"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="286" width="560" height="12" uuid="01d10cf5-9b82-45cd-9f0c-dd7a73e576e3"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{jenis_pembiayaan}!=null && $F{jenis_pembiayaan}.toUpperCase().contains("KETENAGAKERJAAN") ? "[ v ]" : "[   ]") + " BPJS Ketenagakerjaan"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="299" width="545" height="12" uuid="32c796c5-39b9-44d9-8b66-a1bbf16ad113"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["No. Kartu Peserta " + ($F{jenis_pembiayaan}!=null && $F{jenis_pembiayaan}.toUpperCase().contains("KETENAGAKERJAAN") && $F{no_jkn_jasa_raharja}!=null && !$F{no_jkn_jasa_raharja}.equals("-") ? $F{no_jkn_jasa_raharja} : "")]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="312" width="560" height="12" uuid="6acc27a4-44d2-44d1-a0e8-86ca335ac7eb"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{jenis_pembiayaan}!=null && $F{jenis_pembiayaan}.toUpperCase().contains("BPJS KESEHATAN") ? "[ v ]" : "[   ]") + " BPJS Kesehatan"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="325" width="545" height="12" uuid="eef11bea-56fc-487a-831e-52a22a7bf573"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["No. Kartu Peserta " + ($F{jenis_pembiayaan}!=null && $F{jenis_pembiayaan}.toUpperCase().contains("BPJS KESEHATAN") && $F{no_jkn_jasa_raharja}!=null && !$F{no_jkn_jasa_raharja}.equals("-") ? $F{no_jkn_jasa_raharja} : "")]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="338" width="545" height="12" uuid="cc41e1c3-b988-4897-833e-64e5984316c7"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Hak Kelas Perawatan " + ($F{hak_kelas}==null ? "" : $F{hak_kelas})]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="351" width="560" height="12" uuid="bc1f3233-71ba-4138-8c39-325c3af5cad7"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["1. Saya telah mendapatkan informasi dan penjelasan dari pihak Rumah Sakit mengenai Ruang Rawat Inap sesuai Hak Kelas Tersedia."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="364" width="560" height="12" uuid="b1927bf3-e9c1-4667-bbc5-5b65da067d56"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["2. Kami sudah mengetahui kamar sesuai Hak Kelas Rawat Pasien masih tersedia."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="377" width="560" height="12" uuid="58f9e653-137b-4b88-9884-f794e7e7161e"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["3. Bersedia mengikuti ketentuan sesuai dengan PERMENKES 28 tahun 2014, PERMENKES No.3 tahun 2023 :"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="390" width="545" height="12" uuid="27f121fe-c2bc-46d1-81d2-a64386817a21"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["a) Naik kelas perawatan bisa lebih dari 2 tingkat"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="403" width="545" height="12" uuid="330f0869-8da4-424f-bf9f-beb9aac666e1"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["b) Untuk peserta JKN kelas 3 tidak diperkenankan untuk naik kelas rawat inap baik PBI maupun PBPU dan bila pasien menginginkan naik kelas maka penjaminan JKN nya gugur (Penjamin Umum)"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="416" width="545" height="12" uuid="cde28049-47b3-46a7-9bde-80b2606e984f"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["c) Untuk peserta JKN kelas 2 kenaikan kelas pelayanan rawat inap dapat dilakukan 2 tingkat lebih tinggi dari kelas yang menjadi hak peserta dan tidak melebihi total tarif Rumah Sakit."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="429" width="560" height="12" uuid="fefb443e-d04a-4126-b48d-739e8ecefcd4"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["4. Setelah mengetahui kamar sesuai hak kelas rawat masih tersedia kami MEMUTUSKAN untuk dirawat (lingkari dan paraf di samping pilihan)"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="442" width="545" height="12" uuid="9ea44a24-c670-4319-8b52-a418c19b6e68"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{pilihan_kamar}!=null && $F{pilihan_kamar}.contains("Sesuai") ? "a) (\u221A) Sesuai Hak Kelas Rawat" : "a) Sesuai Hak Kelas Rawat")]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="455" width="545" height="12" uuid="233c23c3-f962-4595-b552-13611b3d4dd3"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{pilihan_kamar}!=null && $F{pilihan_kamar}.contains("Naik") ? "b) (\u221A) Naik Kelas Hak Rawat" : "b) Naik Kelas Hak Rawat") + " Alasan : " + ($F{alasan_naik_kelas}==null ? "" : $F{alasan_naik_kelas})]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="468" width="560" height="12" uuid="6e092d4f-2347-4a3e-bead-7938104d2fe6"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["5. Jika kami memilih poin a maka kami tidak dibebankan biaya apapun."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="481" width="560" height="12" uuid="59e19113-cec6-4bea-b36f-4dc3a6b007dc"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["6. Jika kami memilih poin b kami telah dijelaskan akan ada resiko Selisih Biaya sebesar:"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="494" width="545" height="12" uuid="59af27fb-19e6-484f-916c-577520cd5b3b"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["a) Untuk kenaikan kelas pelayanan rawat inap dari kelas 2 ke kelas 1 perhitungannya selisih Tarif INA CBG's pada kelas rawat inap kelas 1 dikurangi Tarif INA CBG's pada kelas rawat inap kelas 2, tidak melebihi total tarif Rumah Sakit."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="507" width="545" height="12" uuid="4fa3be2b-1724-42bb-a03b-f1f8516bc176"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["b) Untuk kenaikan kelas pelayanan rawat inap kelas 2 naik kelas ke pelayanan rawat inap 2 tingkat di atasnya(VIP), perhitungannya selisih tarif INA-CBG's antara kelas 1 dikurangi kelas 2 di tambah maksimal 75% dari tarif INA-CBG's kelas 1 dan tidak melebihi total tarif Rumah Sakit."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="520" width="545" height="12" uuid="bdc169b1-d3f9-4155-aeb4-fa11e400aefe"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["c) Untuk kenaikan kelas pelayanan rawat inap dari kelas 1 ke kelas perawatan satu tingkat diatas kelas 1 (VIP/VVIP/DLL), maka selisih biaya sebesar 75% dari tarif INA CBG kelas 1 dan tidak melebihi total tarif Rumah Sakit."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="0" y="533" width="572" height="12" uuid="c21d087f-b2f3-4944-8f26-ec0f7f4e90ec"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya yang menyatakan bahwa akan mengikuti semua ketentuan dan tata cara pelayanan yang berlaku di "+$P{namars}+". Apabila saya tidak memenuhi kewajiban, saya bersedia di tuntut secara hukum di pengadilan.\nDemikian surat pernyataan ini saya buat dengan penuh tanggung jawab dan dalam keadaan sadar tanpa ada paksaan dari pihak manapun untuk digunakan sebagaimana mestinya."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="380" y="559" width="180" height="12" uuid="23a8e1f5-a55a-4676-bcb3-3474a0024a89"/>
				<textElement textAlignment="Center">
					<font fontName="Tahoma" size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{kotars}+", "+new SimpleDateFormat("dd-MM-yyyy").format($F{tanggal})]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="10" y="574" width="170" height="11" uuid="829f8e92-b6ab-4518-a14f-ee57bcab5c8a"/>
				<textElement textAlignment="Center">
					<font fontName="Tahoma" size="9"/>
				</textElement>
				<text><![CDATA[Saksi I (pihak Rumah Sakit)]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="210" y="574" width="170" height="11" uuid="9aa89835-d460-4101-b1e6-d72052ab4983"/>
