		</band>
		<band height="171">
			<staticText>
				<reportElement x="0" y="0" width="572" height="12" uuid="a1b2c3d4-e5f6-7890-1234-567890123456"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[1. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="14" width="560" height="12" uuid="c1d2e3f4-a5b6-7890-1234-567890123456"/>
				<textElement textAlignment="Justified" markup="none">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["a. Saya mengetahui bahwa saya memiliki kondisi yang membutuhkan perawatan medis, saya mengijinkan dokter dan profesional kesehatan lainnya untuk melakukan prosedur diagnostik, elektrokardiogram dan untuk memberikan pengobatan medis seperti yang diperlukan dalam penilaian profesional mereka.\n"+
"b. Saya mengijinkan prosedur diagnostik dan perawatan medis termasuk terapi tidak terbatas pada elektrokardiogram, x-ray, tes darah, terapi fisik dan pemberian obat-obatan.\n"+
"c. Saya sadar bahwa praktik kedokteran dan bedah bukanlah ilmu pasti dan saya mengakui tidak ada jaminan atas hasil apapun terhadap prosedur atau pemeriksaan apapun yang dilakukan kepada saya."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="28" width="545" height="12" uuid="12345678-90ab-cdef-1234-567890abcdef"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya mengerti dan memahami bahwa :\n"+
"-  Saya memiliki hak untuk mengajukan pertanyaan tentang pengobatan yang diusulkan (termasuk identitas setiap orang yang memberikan atau mengamati pengobatan) setiap saat.\n"+
"-  Saya mengerti dan memahami bahwa saya memiliki hak untuk persetujuan atau menolak persetujuan untuk setiap prosedur/tindakan.\n"+
"-  Saya mengerti bahwa banyak dokter pada staf medis rumah sakit yang bukan karyawan tetap staf tamu yang telah diberikan hak untuk menggunakan fasilitas untuk perawatan dan pengobatan pasien mereka."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="42" width="545" height="12" uuid="34567890-abcd-ef12-3456-7890abcdef12"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Melalui dokumen ini, saya menegaskan kembali bahwa saya mempercayakan kepada semua tenaga kesehatan rumah sakit untuk memberikan perawatan, diagnostik, dan terapi kepada saya sebagai pasien rawat inap atau rawat jalan atau instalasi gawat darurat (IGD), termasuk semua pemeriksaan penunjang, yang dibutuhkan untuk pengobatan dan tindakan yang aman."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="56" width="572" height="12" uuid="45678901-bcde-f123-4567-890abcdef123"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[2. PERSETUJUAN PELEPASAN INFORMASI]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="70" width="560" height="12" uuid="e649920b-230e-45f7-aa39-d527155a3a46"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["a. " + ("Saya memahami informasi yang ada dalam diri saya termasuk diagnosa, hasil laboratorium dan hasil tes diagnostik yang akan digunakan untuk perawatan medis "+$P{namars}+" akan menjamin kerahasiaannya.")]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="84" width="560" height="12" uuid="4ada8cfd-7685-4d86-8233-cd7772b29591"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["b. " + ("Saya memberi wewenang kepada "+$P{namars}+" untuk memberikan informasi tentang diagnosa, hasil pelayanan dan pengobatan bila diperlukan untuk memproses klaim asuransi/ Jamkesmas/Jamkesda/Perusahaan atau lembaga pemerintah.")]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="98" width="560" height="12" uuid="beb1d31c-8000-404d-9e73-e78881bcc808"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["c. " + ("Saya memberi wewenang kepada "+$P{namars}+" untuk memberikan informasi tentang diagnosa, hasil pelayanan dan pengobatan saya kepada anggota keluarga saya, kepada:\n"+
"1. " + ($F{keluarga_1}.trim().equals("") ? "............................................................." : $F{keluarga_1}.trim()) + "\n"+
"2. " + ($F{keluarga_2}.trim().equals("") ? "............................................................." : $F{keluarga_2}.trim()))]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="112" width="560" height="12" uuid="79623836-5200-40f1-b4b5-5134fbefd679"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["d. Saya mengetahui dan menyetujui bahwa berdasarkan Peraturan Menteri Kesehatan No. 24 Tahun 2022 tentang Rekam Medis, fasilitas pelayanan kesehatan wajib membuka akses dan mengirim data rekam medis kepada Kementrian Kesehatan melalui Platform SATUSEHAT."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="126" width="560" height="12" uuid="026d6aa4-356e-4d98-96b5-6b18c5bed459"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["e. Menyetujui untuk menerima dan membuka data pasien dari Fasilitas Pelayanan Kesehatan lainnya melalui SATUSEHAT untuk kepentingan pelayanan kesehatan dan/atau rujukan."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="140" width="572" height="12" uuid="56789012-6789-0123-4567-123456789012"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[3. PRIVASI]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="154" width="560" height="12" uuid="67890123-7890-1234-5678-234567890123"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya " + ($F{privasi_akses}.trim() == null ? "mengijinkan/tidak mengijinkan" : $F{privasi_akses}.trim()) + " kepada "+$P{namars}+" memberi akses bagi keluarga dan handai taulan serta orang-orang yang akan menengok/menemui saya.\n"+
"Saya " + ($F{privasi_khusus}.trim() == null ? "menginginkan/tidak menginginkan" : $F{privasi_khusus}.trim()) + " privasi khusus."]]></textFieldExpression>
			</textField>
		</band>
		<band height="241">
			<staticText>
				<reportElement positionType="Float" x="0" y="0" width="572" height="12" uuid="78901234-8901-2345-6789-345678901234"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[4. BARANG-BARANG MILIK PASIEN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="14" width="560" height="12" uuid="89012345-9012-3456-7890-456789012345"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya telah memahami tata tertib "+$P{namars}+" bahwa saya dilarang membawa barang berharga, alat elektronik, karena jika terjadi kehilangan rumah sakit tidak bertanggung jawab kecuali jika saya menitipkan barang berharga saya ke rumah sakit dengan mengisi formulir penitipan dan pengambilan harta benda."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="28" width="572" height="12" uuid="90123456-0123-4567-8901-567890123456"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[5. HAK DAN KEWAJIBAN PASIEN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="42" width="560" height="12" uuid="01234567-1234-5678-9012-678901234567"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Dengan menandatangani dokumen ini saya mengakui bahwa pada proses pendaftaran untuk mendapatkan perawatan di "+$P{namars}+" telah mendapatkan informasi tentang hak-hak dan kewajiban saya sebagai pasien sebagaimana tercantum pada Undang-Undang No. 44 Tahun 2009 tentang Hak Pasien dan Kewajiban Pasien (Terlampir)."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="56" width="572" height="12" uuid="12345678-2345-6789-0123-789012345678"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[6. RAHASIA MEDIS]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="70" width="560" height="12" uuid="23456789-3456-7890-1234-890123456789"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya setuju "+$P{namars}+" wajib menjamin kerahasiaan informasi medis saya baik untuk kepentingan perawatan dan pengobatan, pendidikan maupun penelitian kecuali saya mengungkapkan sendiri orang yang lain yang saya beri kuasa untuk itu."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="84" width="572" height="12" uuid="34567890-4567-8901-2345-901234567890"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[7. PENGAJUAN KELUHAN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="98" width="560" height="12" uuid="45678901-5678-9012-3456-012345678901"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya menyatakan bahwa saya telah menerima informasi tentang adanya tatacara mengajukan dan mengatasi keluhan terkait pelayanan medik yang diberikan terhadap diri saya. Saya setuju untuk mengikuti tata cara mengajukan keluhan sesuai prosedur yang ada."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="112" width="572" height="12" uuid="56789012-6789-0123-4567-123456789012"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[8. PELAYANAN KEROHANIAN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="126" width="560" height="12" uuid="67890123-7890-1234-5678-234567890123"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya memahami informasi bahwa selama perawatan di ruang rawat inap akan diberikan satu kali pelayanan kerohanian sesuai dengan agama "+$F{agama}+" yang saya anut kecuali bila saya non muslim, saya akan mengajukan permintaan pelayanan kerohanian kepada "+$P{namars}+"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="140" width="572" height="12" uuid="78901234-8901-2345-6789-345678901234"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[9. IDENTIFIKASI NILAI-NILAI DAN KEPERCAYAAN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="154" width="560" height="12" uuid="89012345-9012-3456-7890-456789012345"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya / Pasien memohon kepada "+$P{namars}+" agar tidak memberikan terapi atau melakukan tindakan yang bertentangan dengan nilai-nilai akan kepercayaan saya / pasien."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="168" width="572" height="12" uuid="90123456-0123-4567-8901-567890123456"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[10. INFORMASI RAWAT JALAN / RAWAT INAP]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="182" width="560" height="12" uuid="5826f095-2cb1-4161-916c-4fc4d38c0aaa"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["a. Saya/pasien tidak diperkenankan untuk membawa barang berharga keruang rawat jalan/inap dan saya memahami bahwa "+$P{namars}+" tidak bertanggungjawab apabila terjadi kehilangan barang milik pasien/pengunjung."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="196" width="560" height="12" uuid="be1e1873-f41b-4e69-bfe8-dd4ef4eb2edd"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["b. Bila tidak ada anggota keluarga, rumah sakit menyediakan tempat penitipan barang milik pasien ditempat resmi yang telah disediakan oleh "+$P{namars}+"."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="210" width="560" height="12" uuid="e880680b-78c4-421c-881f-bf25df54ba50"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["c. Saya telah menerima informasi tentang peraturan yang diberlakukan oleh "+$P{namars}+" dan saya beserta keluarga bersedia mematuhinya, termasuk akan mematuhi jam berkunjung pasien sesuai dengan aturan "+$P{namars}+"."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="224" width="560" height="12" uuid="33b788b3-0068-4e93-8988-cbf8d8e40e13"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["d. Anggota keluarga yang menunggu saya, bersedia untuk selalu memakai tanda pengenal khusus yang diberikan "+$P{namars}+", demi keamanan seluruh pasien setiap keluarga dan siapapun yang mengunjungi saya diluar jam berkunjung, bersedia untuk diminta/diperiksa identitasnya dan memakai identitas yang diberikan oleh "+$P{namars}+"."]]></textFieldExpression>
			</textField>
		</band>
								<band height="695">
			<staticText>
				<reportElement positionType="Float" x="0" y="0" width="572" height="12" uuid="77a1e1c0-7b64-42f2-bae2-3e6f9feed0da"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[11. INFORMASI BIAYA]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="13" width="560" height="12" uuid="0226345f-700e-45d1-bf8b-20c03f8c01e1"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya memahami dan menyetujui tentang informasi biaya pengobatan ataupun tindakan yang telah dijelaskan oleh petugas sesuai dengan peraturan "+$P{namars}+" :"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="27" y="26" width="545" height="12" uuid="af6275cc-4747-40d2-8f36-4da53ad344ee"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Pasien Rawat Jalan]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="37" y="39" width="535" height="12" uuid="ae061116-0ce8-468e-b01b-84be553eb640"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{informasi_biaya}!=null && $F{informasi_biaya}.toUpperCase().contains("RAWAT JALAN") ? "[ v ]" : "[   ]") + " Saat mendaftar di Instalasi Rawat Jalan, wajib melengkapi persyaratan jaminan pembayaran "+$P{namars}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="27" y="52" width="545" height="12" uuid="fe682335-e445-454a-92c7-b0b5d504065a"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Pasien Rawat Inap]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="37" y="65" width="535" height="12" uuid="1cb74446-782e-425b-8230-83a719b93c90"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["\u2610 Bersedia melengkapi persyaratan jaminan pembayaran dalam waktu 1 x 24 jam terhitung sejak hari, tanggal dan jam masuk di "+$P{namars}+".\nApabila dalam tempo waktu yang telah ditetapkan, tidak dapat menyatakan jaminan BPJS maka bersedia menjadi pasien umum"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="27" y="78" width="545" height="12" uuid="e9d065f3-1df5-4698-b927-f409921935a3"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Pasien Instalasi Gawat Darurat]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="37" y="91" width="535" height="12" uuid="e25629cf-088e-4c21-9f10-d1eea78beac1"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{informasi_biaya}!=null && $F{informasi_biaya}.toUpperCase().contains("GAWAT DARURAT") ? "[ v ]" : "[   ]") + " Bagi pasien BPJS yang masuk melalui IGD, apabila hasil skrining awal tidak memenuhi kriteria Gawat Darurat, bersedia untuk membayar biaya perawatan dan terdaftar sebagai pasien umum."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="104" width="572" height="12" uuid="18b51978-ae69-478c-889a-1d29d3567064"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[12. KEWAJIBAN PEMBAYARAN]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="117" width="560" height="12" uuid="814ab0bb-8b54-433b-8fb2-a9c5797d030f"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya menyatakan setuju, baik sebagai wali atau sebagai pasien, bahwa sesuai pertimbangan pelayanan yang diberikan kepada pasien, maka saya wajib untuk membayar total biaya pelayanan. Biaya pelayanan berdasarkan acuan biaya dan ketentuan "+$P{namars}+". Apabila asuransi kesehatan swasta atau program pemerintah menanggung pembiayaan saya, saya memberi wewenang kepada rumah sakit untuk memberi tagihan dari semua pelayanan dan tindakan medis yang diberikan, Tanggungan asuransi saya mungkin menyatakan bahwa sebagian pembayaran tetap menjadi tanggung jawab pribadi saya atau tidak ditanggung oleh asuransi, maka rumah sakit berwenang memberi tagihan untuk biaya yang tidak ditanggung oleh asuransi dan saya bertanggung jawab untuk membayarnya."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="130" width="560" height="12" uuid="b98e4183-dbe1-4fdd-9c12-76f2987d3638"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["a. Apabila saya tidak memberikan persetujuan, atau dikemudian hari mencabut persetujuan saya untuk melepas rahasia kedokteran saya kepada perusahaan asuransi yang saya tentukan, maka saya pribadi bertanggung jawab untuk membayar semua pelayanan dan tindakan medis dari "+$P{namars}+"."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="143" width="560" height="12" uuid="0a9f23e6-8f1c-4d5a-8491-9da7e2149c71"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["b. Apabila rumah sakit membutuhkan proses hukum untuk menagih biaya pelayan rumah sakit dari saya, saya memahami bahwa saya bertanggung jawab untuk membayar semua biaya yang disebabkan dari proses hukum tersebut."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="156" width="560" height="12" uuid="9310ffdd-4310-4309-8c68-f2da28e1b106"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Dengan ini menyatakan BERSEDIA membayar seluruh biaya pelayanan atau selisih di luar pertanggung jawaban jaminan kesehatan sesuai dengan ketentuan "+$P{namars}+" yang terjadi atas diri pasien dengan cara pembayaran sebagai berikut :"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="12" y="169" width="560" height="12" uuid="3cf636e3-cdf9-4645-b580-02bd9f56ad1b"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{jenis_pembiayaan}!=null && $F{jenis_pembiayaan}.toUpperCase().contains("UMUM") ? "[ v ]" : "[   ]") + " UMUM"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="27" y="182" width="545" height="12" uuid="ef3314f0-c518-473c-a8b9-456d48f820d3"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{jenis_pembiayaan}!=null && $F{jenis_pembiayaan}.toUpperCase().contains("UMUM") ? "[ v ]" : "[   ]") + " Saya telah mendapatkan penjelasan manfaat/ jaminan kesehatan dan MENOLAK untuk menggunakan jaminan kesehatan."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="42" y="195" width="530" height="12" uuid="b88f516a-317c-4f5d-ac12-afa51248dd7a"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["BPJS Kesehatan, alasan " + ($F{alasan_tolak_bpjs}==null ? "" : $F{alasan_tolak_bpjs})]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="42" y="208" width="530" height="12" uuid="3b1ff4e3-c256-4178-a667-d1ccf99bb01a"/>
				<textElement textAlignment="Justified">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["BPJS Ketenagakerjaan, alasan " + ($F{alasan_tolak_bpjs_kerja}==null ? "" : $F{alasan_tolak_bpjs_kerja})]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
