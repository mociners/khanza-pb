					<font fontName="Tahoma" size="9"/>
				</textElement>
				<text><![CDATA[Saksi II (pihak keluarga)]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="380" y="574" width="180" height="11" uuid="03afd5b9-9cb9-4814-9e15-2e1b798261a2"/>
