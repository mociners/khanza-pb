			<staticText>
				<reportElement positionType="Float" x="0" y="210" width="555" height="15" uuid="e05030e4-b772-4d2c-80fb-1cb11fdf33f3"/>
				<box topPadding="2" leftPadding="5" bottomPadding="0" rightPadding="5">
					<pen lineWidth="0.5"/>
					<bottomPen lineWidth="0.0"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[B. OBJEKTIF]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="225" width="555" height="110" uuid="b1f3bb9b-4395-4223-9c87-8d3e9db7eec9"/>
				<box topPadding="2" leftPadding="5" bottomPadding="2" rightPadding="5">
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.0"/>
				</box>
				<textElement>
					<font fontName="Tahoma" size="9"/>
				</textElement>
				<textFieldExpression><![CDATA["1. Pemeriksaan Umum:\n   KU: " + ($F{obj_ku} != null ? $F{obj_ku} : "-") + ", Kesadaran: " + ($F{obj_kesadaran} != null ? $F{obj_kesadaran} : "-") + ", GCS: E:" + ($F{obj_gcs_e} != null ? $F{obj_gcs_e} : "-") + " V:" + ($F{obj_gcs_v} != null ? $F{obj_gcs_v} : "-") + " M:" + ($F{obj_gcs_m} != null ? $F{obj_gcs_m} : "-") + "\n"+
"   Tanda Vital: TD: " + ($F{obj_td_sistol} != null ? $F{obj_td_sistol} : "-") + "/" + ($F{obj_td_diastol} != null ? $F{obj_td_diastol} : "-") + " mmHg, HR: " + ($F{obj_hr} != null ? $F{obj_hr} : "-") + " x/m, RR: " + ($F{obj_rr} != null ? $F{obj_rr} : "-") + " x/m, S: " + ($F{obj_suhu} != null ? $F{obj_suhu} : "-") + " C, SpO2: " + ($F{obj_spo2} != null ? $F{obj_spo2} : "-") + "%\n\n"+
"2. Pemeriksaan Fisik:\n" +
"   Kepala: " + ($F{obj_kepala} != null ? $F{obj_kepala} : "-") + "\n" +
"   Mata: " + ($F{obj_mata} != null ? $F{obj_mata} : "-") + "\n" +
"   Leher: " + ($F{obj_leher} != null ? $F{obj_leher} : "-") + "\n" +
"   Thorax: " + ($F{obj_thorax} != null ? $F{obj_thorax} : "-") + "\n" +
"   Abdomen: Inspeksi : " + ($F{obj_inspeksi} != null ? $F{obj_inspeksi} : "-") + ", TFU : " + ($F{obj_tfu} != null ? $F{obj_tfu} : "-") + " cm, TBBJ : " + ($F{obj_tbbj} != null ? $F{obj_tbbj} : "-") + ", His : " + ($F{obj_his} != null ? $F{obj_his} : "-") + "\n" +
"            Leopold I : " + ($F{obj_leopold1} != null ? $F{obj_leopold1} : "-") + "\n" +
"            Leopold II : " + ($F{obj_leopold2} != null ? $F{obj_leopold2} : "-") + "\n" +
"            Leopold III : " + ($F{obj_leopold3} != null ? $F{obj_leopold3} : "-") + "\n" +
"            Leopold IV : " + ($F{obj_leopold4} != null ? $F{obj_leopold4} : "-") + "\n" +
"            Auskultasi : " + ($F{obj_auskultasi} != null ? $F{obj_auskultasi} : "-") + "\n" +
"   Genitalia (Pukul " + ($F{obj_pukul} != null ? $F{obj_pukul} : "-") + " WIB): Pervaginam : " + ($F{obj_pengeluaran} != null ? $F{obj_pengeluaran} : "-") + ", VT : " + ($F{obj_pmxdalam} != null ? $F{obj_pmxdalam} : "-") + ", Inspekulo : " + ($F{obj_inspekulo} != null ? $F{obj_inspekulo} : "-") + "\n" +
"   Ekstremitas: Oedema : " + ($F{obj_oedema1} != null ? $F{obj_oedema1} : "-") + " / " + ($F{obj_oedema2} != null ? $F{obj_oedema2} : "-") + ", Varises : " + ($F{obj_varises1} != null ? $F{obj_varises1} : "-") + " / " + ($F{obj_varises2} != null ? $F{obj_varises2} : "-") + ", Reflek : " + ($F{obj_reflek1} != null ? $F{obj_reflek1} : "-") + " / " + ($F{obj_reflek2} != null ? $F{obj_reflek2} : "-")]]></textFieldExpression>
			</textField>
