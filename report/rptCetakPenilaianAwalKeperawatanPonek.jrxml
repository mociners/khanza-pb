				<textElement verticalAlignment="Middle">
					<font fontName="Tahoma" isBold="true"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[I. RIWAYAT KESEHATAN PASIEN]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="15" width="555" height="40" uuid="cfd01e12-4099-4c22-b258-293e5af3a6b2"/>
				<box topPadding="2" leftPadding="5" bottomPadding="2" rightPadding="5">
					<pen lineWidth="0.5"/>
				</box>
				<textElement>
					<font fontName="Tahoma" size="9"/>
				</textElement>
				<textFieldExpression><![CDATA["Keluhan Utama: " + ($F{keluhan_utama} != null ? $F{keluhan_utama} : "-") + "\n" +
"Riwayat Penyakit Dahulu: " + ($F{rpd} != null ? $F{rpd} : "-") + "\n" +
"Riwayat Penggunaan Obat: " + ($F{rpo} != null ? $F{rpo} : "-")]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" mode="Opaque" x="0" y="55" width="555" height="15" backcolor="#E6E6E6" uuid="f05b0a70-8b1e-450e-b2d9-1c6e140d046c"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Tahoma" isBold="true"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[II. ASSESMEN KEBIDANAN & KANDUNGAN]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="0" y="70" width="555" height="15" uuid="5fa75fc6-92d1-4db8-bbd6-218ba723eb1b"/>
				<box topPadding="2" leftPadding="5" bottomPadding="0" rightPadding="5">
					<pen lineWidth="0.5"/>
					<bottomPen lineWidth="0.0"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Tahoma" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[A. DATA SUBJEKTIF]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="85" width="555" height="60" uuid="e3b09228-5690-482d-9372-e160a22c5496"/>
				<box topPadding="2" leftPadding="5" bottomPadding="2" rightPadding="5">
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.0"/>
				</box>
				<textElement>
					<font fontName="Tahoma" size="9"/>
				</textElement>
				<textFieldExpression><![CDATA["1. Riwayat Menstruasi:\n   Menarche: " + ($F{menarche_umur} != null ? $F{menarche_umur} : "-") + " th, Siklus: " + ($F{siklus_menstruasi} != null ? $F{siklus_menstruasi} : "-") + " hari (" + ($F{keteratan_menstruasi} != null ? $F{keteratan_menstruasi} : "-") + "), Lama: " + ($F{lama_menstruasi} != null ? $F{lama_menstruasi} : "-") + " hari, Keluhan: " + ($F{keluhan_haid} != null ? $F{keluhan_haid} : "-") + "\n\n"+
"2. Riwayat Kehamilan Sekarang:\n   Hamil ke: " + ($F{hamil_ke} != null ? $F{hamil_ke} : "-") + ", UK: " + ($F{uk_minggu} != null ? $F{uk_minggu} : "-") + " Mgg " + ($F{uk_hari} != null ? $F{uk_hari} : "-") + " Hari, HPHT: " + ($F{hpht_kbd} != null ? $F{hpht_kbd} : "-") + ", HPL: " + ($F{hpl_kbd} != null ? $F{hpl_kbd} : "-") + "\n" +
"   BB Sblm Hamil: " + ($F{bb_sebelum_hamil} != null ? $F{bb_sebelum_hamil} : "-") + " Kg, BB Skrg: " + ($F{bb_sekarang} != null ? $F{bb_sekarang} : "-") + " Kg, TB: " + ($F{tb_kbd} != null ? $F{tb_kbd} : "-") + " cm\n" +
"   Periksa ANC: " + ($F{periksa_anc} != null ? $F{periksa_anc} : "-") + " kali di " + ($F{anc_di} != null ? $F{anc_di} : "-") + " " + ($F{anc_lainnya} != null ? $F{anc_lainnya} : "-") + "\n" +
"   Imunisasi TT: " + ($F{imunisasi_tt} != null ? $F{imunisasi_tt} : "-") + " kali (TT I: " + ($F{tgl_tt1} != null ? $F{tgl_tt1} : "-") + ", TT II: " + ($F{tgl_tt2} != null ? $F{tgl_tt2} : "-") + ")\n" +
"   Gerakan Janin (12 jam terakhir): " + ($F{gerakan_janin} != null ? $F{gerakan_janin} : "-") + " kali"]]></textFieldExpression>
			</textField>
			<staticText>
