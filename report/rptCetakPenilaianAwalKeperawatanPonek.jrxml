	<queryString>
		<![CDATA[select penilaian_awal_keperawatan_ponek.*, pasien.no_rkm_medis, pasien.nm_pasien, if(pasien.jk='L','Laki-Laki','Perempuan') as jk, pasien.tgl_lahir, petugas.nama from penilaian_awal_keperawatan_ponek 
		inner join reg_periksa on penilaian_awal_keperawatan_ponek.no_rawat=reg_periksa.no_rawat 
		inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis 
		inner join petugas on penilaian_awal_keperawatan_ponek.nip=petugas.nip 
		where penilaian_awal_keperawatan_ponek.no_rawat=$P{no_rawat}]]>
	</queryString>
