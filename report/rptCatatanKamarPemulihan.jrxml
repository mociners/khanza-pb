	<parameter name="finger" class="java.lang.String"/>
	<queryString>
		<![CDATA[select reg_periksa.no_rawat, pasien.no_rkm_medis, pasien.nm_pasien, pasien.tgl_lahir, catatan_kamar_pemulihan.jam_masuk, 
catatan_kamar_pemulihan.status_pernapasan, catatan_kamar_pemulihan.spontan, catatan_kamar_pemulihan.status_kesadaran, 
catatan_kamar_pemulihan.aktifitas1, catatan_kamar_pemulihan.sirkulasi1, catatan_kamar_pemulihan.pernapasan1, 
catatan_kamar_pemulihan.kesadaran1, catatan_kamar_pemulihan.warnakulit1, catatan_kamar_pemulihan.total1, 
catatan_kamar_pemulihan.jamdi, catatan_kamar_pemulihan.aktifitas2, catatan_kamar_pemulihan.sirkulasi2, 
catatan_kamar_pemulihan.pernapasan2, catatan_kamar_pemulihan.kesadaran2, catatan_kamar_pemulihan.kulit2, catatan_kamar_pemulihan.total2, 
catatan_kamar_pemulihan.vas, catatan_kamar_pemulihan.jamkeluar, catatan_kamar_pemulihan.aktifitas3, catatan_kamar_pemulihan.sirkulasi3, 
catatan_kamar_pemulihan.pernapasan3, catatan_kamar_pemulihan.kesadaran3, catatan_kamar_pemulihan.kulit3, 
catatan_kamar_pemulihan.total3, catatan_kamar_pemulihan.ke, catatan_kamar_pemulihan.catatan, 
catatan_kamar_pemulihan.kesakitan, catatan_kamar_pemulihan.mualmuntah, catatan_kamar_pemulihan.obat, 
catatan_kamar_pemulihan.infus, catatan_kamar_pemulihan.pemantauan, catatan_kamar_pemulihan.selama, catatan_kamar_pemulihan.lainnya, 
catatan_kamar_pemulihan.pegawai, petugas.nama 
from catatan_kamar_pemulihan inner join reg_periksa on catatan_kamar_pemulihan.no_rawat=reg_periksa.no_rawat 
inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis 
inner join petugas on catatan_kamar_pemulihan.pegawai=petugas.nip]]>
	</queryString>
